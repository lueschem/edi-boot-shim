kernel_image=/boot/vmlinuz-__KERNEL_PACKAGE_VERSION__
# the raspberrry pi 3 starts without initramfs
initramfs_image=""
device_tree_binaries=(
    /usr/lib/linux-image-__KERNEL_PACKAGE_VERSION__/broadcom/bcm2710-rpi-2-b.dtb
    /usr/lib/linux-image-__KERNEL_PACKAGE_VERSION__/broadcom/bcm2710-rpi-3-b.dtb
    /usr/lib/linux-image-__KERNEL_PACKAGE_VERSION__/broadcom/bcm2710-rpi-3-b-plus.dtb
    /usr/lib/linux-image-__KERNEL_PACKAGE_VERSION__/broadcom/bcm2710-rpi-cm0.dtb
    /usr/lib/linux-image-__KERNEL_PACKAGE_VERSION__/broadcom/bcm2710-rpi-cm3.dtb
    /usr/lib/linux-image-__KERNEL_PACKAGE_VERSION__/broadcom/bcm2710-rpi-zero-2.dtb
    /usr/lib/linux-image-__KERNEL_PACKAGE_VERSION__/broadcom/bcm2710-rpi-zero-2-w.dtb
)
device_tree_binary_overlays=(
    /usr/lib/linux-image-__KERNEL_PACKAGE_VERSION__/overlays/vc4-fkms-v3d.dtbo
    /usr/lib/linux-image-__KERNEL_PACKAGE_VERSION__/overlays/vc4-kms-v3d.dtbo
    /usr/lib/linux-image-__KERNEL_PACKAGE_VERSION__/overlays/gpio-ir-tx.dtbo
    /usr/lib/linux-image-__KERNEL_PACKAGE_VERSION__/overlays/gpio-ir.dtbo
)
